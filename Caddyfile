# Reverse proxy in front of the Nuxt app.
# Caddy auto-provisions Let's Encrypt certs for the domains listed below.
#
# Cloudflare SSL/TLS mode must be "Full (strict)" — Caddy answers with a valid
# LE cert on the origin, and Cloudflare re-encrypts to the visitor.
# If you keep Cloudflare "orange cloud" (proxied), LE HTTP-01 challenge still
# works because CF forwards :80/:443 traffic through.

{
    # Contact for LE expiration warnings.
    email panic8612@gmail.com
}

# Redirect www → apex.
www.tynkybordel.shop {
    redir https://tynkybordel.shop{uri} permanent
}

tynkybordel.shop {
    encode zstd gzip

    # ── Security headers ────────────────────────────────────────────────────
    # Applied to every response. No CSP here on purpose: the storefront loads
    # PayPal + Packeta widgets and inlines styles, so a policy tight enough to
    # be worth having needs testing against a real checkout first.
    header {
        # Force HTTPS for a year. Add `preload` + submit to hstspreload.org only
        # once you're certain every subdomain will always be HTTPS — it's hard
        # to undo.
        Strict-Transport-Security "max-age=31536000; includeSubDomains"
        # Don't let browsers guess a type other than what we declare.
        X-Content-Type-Options "nosniff"
        # No embedding in frames — blocks clickjacking of the checkout/admin.
        X-Frame-Options "DENY"
        # Send the origin only, and never to plain-HTTP sites.
        Referrer-Policy "strict-origin-when-cross-origin"
        # We use none of these APIs.
        Permissions-Policy "camera=(), microphone=(), geolocation=(), interest-cohort=()"
        # Don't advertise the server software.
        -Server
    }

    # Long cache for immutable Nuxt build assets + optimized images.
    @static path /_nuxt/* /_ipx/* /favicon.ico /manifest.webmanifest /pwa/*
    header @static Cache-Control "public, max-age=31536000, immutable"

    # Uploaded product images — moderate cache, allow revalidation.
    @uploads path /uploads/*
    header @uploads Cache-Control "public, max-age=86400"

    # Never cache API/auth at the edge. Caching /api/auth/get-session breaks
    # login — Cloudflare would hand an authenticated visitor a stale, cached
    # "logged-out" session. This forces no-store regardless of what the handler
    # sets, so Cloudflare won't cache it.
    @api path /api/*
    header @api Cache-Control "no-store, no-cache, must-revalidate, private"

    reverse_proxy app:3000
}
