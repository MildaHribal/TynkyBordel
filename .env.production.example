# Production environment for tynkybordel.shop
# ─────────────────────────────────────────────────────────────────────────────
# Copy to `.env.production` on the VPS and fill in. NEVER commit the real file —
# this repository is public.
#
#   cp .env.production.example .env.production && nano .env.production
#
# The app refuses to start if any REQUIRED variable is missing
# (see server/plugins/00-validate-env.ts).

# ─── REQUIRED ────────────────────────────────────────────────────────────────

# Postgres. The password is also consumed by docker-compose.prod.yml to
# initialise the database container, so set it before the first `up`.
POSTGRES_USER=shopik
POSTGRES_PASSWORD=
POSTGRES_DB=shopik
# DATABASE_URL is assembled automatically in docker-compose.prod.yml — leave it
# unset here unless you point the app at an external database.

# Session signing key. Generate with:  openssl rand -base64 48
# Must be at least 32 characters or the app refuses to boot.
BETTER_AUTH_SECRET=

# Public origin. Both must be the real https URL — auth callbacks, canonical
# tags, the sitemap and email links all derive from them.
BETTER_AUTH_URL=https://tynkybordel.shop
NUXT_PUBLIC_SITE_URL=https://tynkybordel.shop

# ─── Email (required for order confirmations & password resets) ──────────────
# Seznam Email Profi: host smtp.seznam.cz, port 465, secure true.
# MAIL_FROM must be the SAME address as SMTP_USER or Seznam rejects the send.
SMTP_HOST=smtp.seznam.cz
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=info@tynkybordel.shop
SMTP_PASS=
MAIL_FROM=Tynky Bordel <info@tynkybordel.shop>

# Where new-order and contact-form notifications land.
# Defaults to the MAIL_FROM address when left empty.
ORDER_NOTIFICATION_EMAIL=

# ─── Bank transfer (QR payment) ──────────────────────────────────────────────
# Either set BANK_ACCOUNT_IBAN directly, or the local number + bank code and the
# IBAN is computed from them.
BANK_ACCOUNT_NUMBER=
BANK_ACCOUNT_BANK_CODE=
BANK_ACCOUNT_PREFIX=
BANK_ACCOUNT_HOLDER=Tynky Bordel
# BANK_ACCOUNT_IBAN=

# ─── Packeta / Zásilkovna ────────────────────────────────────────────────────
NUXT_PUBLIC_PACKETA_API_KEY=
NUXT_PACKETA_API_SECRET=

# ─── PayPal (card payments) ──────────────────────────────────────────────────
# Switch PAYPAL_ENV to `live` and swap in the live credentials before taking
# real money. The client id is public by design; the secret is server-only.
PAYPAL_ENV=sandbox
PAYPAL_CLIENT_ID=
PAYPAL_SECRET=
NUXT_PUBLIC_PAYPAL_CLIENT_ID=

# ─── Optional ────────────────────────────────────────────────────────────────

# Google sign-in. Leave empty to hide the "Sign in with Google" button.
# Redirect URI: https://tynkybordel.shop/api/auth/callback/google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Extra admin accounts (comma-separated emails). Admin can also be granted by
# setting is_admin = true on the user row in the database.
ADMIN_EMAILS=

# PostHog analytics. Only loads after the visitor accepts the cookie banner;
# leave empty to disable analytics entirely.
NUXT_PUBLIC_POSTHOG_KEY=
NUXT_PUBLIC_POSTHOG_HOST=https://eu.i.posthog.com

# Set to true to skip the automatic migration run on boot (debugging only).
DISABLE_BOOT_MIGRATE=false

# ─── Not used ────────────────────────────────────────────────────────────────
# Stripe was replaced by PayPal. The endpoints stay dormant (503) while these
# are empty — only fill them in if you deliberately switch back.
# NUXT_STRIPE_SECRET_KEY=
# NUXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
# STRIPE_WEBHOOK_SECRET=
